{
  "name": "xing-xu-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-production.ps1",
    "cf:build:production": "node scripts/cloudflare-build.mjs",
    "cf:deploy:production": "node scripts/cloudflare-deploy.mjs",
    "cf:dry-run:production:ci": "node scripts/cloudflare-deploy.mjs --dry-run",
    "check:ci": "npm run check:worker && npm test && wrangler types --check",
    "ci:build": "npm run cf:build:production",
    "check": "astro check",
    "check:worker": "tsc -p tsconfig.worker.json",
    "test": "vitest run && node --test test/cloudflare-ci.test.mjs",
    "preview": "astro preview",
    "cf:dev": "npm run build && wrangler dev",
    "cf:types": "wrangler types",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "cf:dry-run:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-production.ps1 -DryRun"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@types/node": "^26.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  }
}
