{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xing-xu-website",
  "account_id": "e4aaa1d1aea8505cff4d65aa23cd0551",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "RFQ_MODE": "local-test",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
    "RFQ_FROM_EMAIL": "rfq@local.test"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "RFQ_TO_EMAIL"]
  },
  "send_email": [
    {
      "name": "RFQ_EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "xing-xu-website",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "RFQ_MODE": "live",
        "TURNSTILE_HOSTNAMES": "xingxufan.com",
        "RFQ_FROM_EMAIL": "rfq@xingxufan.com"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "RFQ_TO_EMAIL"]
      },
      "send_email": [
        {
          "name": "RFQ_EMAIL",
          "destination_address": "__RFQ_TO_EMAIL_FROM_IGNORED_CONFIG__",
          "allowed_sender_addresses": ["rfq@xingxufan.com"]
        }
      ]
    }
  }
}
