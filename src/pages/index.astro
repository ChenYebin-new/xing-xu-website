---
import { Image } from "astro:assets";
import { productDetails } from "../data/imagery";

import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  audiencePaths,
  capabilities,
  contactChannels,
  productCategories,
} from "../data/site";

const pageTitle = "XINGXU FAN | Industrial Fan Supply & Sourcing";
const pageDescription =
  "Quanzhou-based industrial fan supply, selection advice, cross-brand sourcing, export packaging and logistics coordination for Southeast Asian buyers.";

---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="top">
    <section class="hero" id="about" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="company-name">Quanzhou Xingxu Fan & Ventilation Supply</p>
        <h1 id="hero-title">Nearly 30 Years of Hands-On Fan Supply</h1>
        <p class="hero__lede">
          Industrial fan supply and sourcing support for distributors, engineering contractors and equipment
          manufacturers in Malaysia and the Philippines.
        </p>
        <div class="hero__actions">
          <a class="button" href="/request-a-quote/">Request a Quote <Icon name="arrow" size={21} /></a>
          <a class="text-link" href="/products/">Explore Products <Icon name="arrow" size={19} /></a>
        </div>
      </div>

      <figure class="hero-product" id="fan-gallery" aria-label="Fan construction gallery">
        <div class="hero-product__frame" id="product-view">
          <Image
            data-gallery-image="overview"
            src={productCategories[2].productImage}
            alt={productCategories[2].productAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 720px) 90vw, (max-width: 1180px) 52vw, 35vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          {productDetails.map((slot, index) => (
            <Image
              data-gallery-image={String(index)}
              src={slot.image}
              alt={slot.alt}
              widths={[480, 720, 960]}
              sizes="(max-width: 720px) 90vw, (max-width: 1180px) 52vw, 40vw"
              format="webp"
              loading="lazy"
              hidden
            />
          ))}
          <span class="inspection-line" aria-hidden="true"></span>
        </div>
        <figcaption class="hero-product__caption">
          <span data-gallery-caption aria-live="polite" aria-atomic="true">Centrifugal fan · Overview</span>
          <button type="button" data-gallery-reset hidden disabled>Back to overview <Icon name="arrow" size={16} /></button>
        </figcaption>
      </figure>

      <aside class="evidence" id="evidence" aria-labelledby="evidence-title">
        <div class="evidence__heading">
          <span aria-hidden="true"></span>
          <h2 id="evidence-title">A Closer Look</h2>
        </div>
        <div class="evidence__grid">
          {
            productDetails.map((slot, index) => (
              <a class="evidence-slot" href={slot.image.src} data-gallery-select={String(index)} data-gallery-label={slot.label} aria-label={`View ${slot.label.toLowerCase()}`} aria-controls="product-view">
                <div class="evidence-slot__visual">
                  <Image
                    src={slot.image}
                    alt={slot.alt}
                    widths={[320, 480]}
                    sizes="(max-width: 720px) 44vw, (max-width: 1180px) 22vw, 15vw"
                    format="webp"
                    loading="lazy"
                  />
                </div>
                <h3>{slot.label}</h3>
                <p>{slot.detail}</p>
              </a>
            ))
          }
        </div>
      </aside>
    </section>

    <section class="capabilities" id="selection" aria-label="Confirmed support capabilities">
      {
        capabilities.map((capability) => (
          <article>
            <span aria-hidden="true"></span>
            <div>
              <h2>{capability.title}</h2>
              <p>{capability.detail}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="products" id="products" aria-labelledby="products-title">
      <div class="section-heading">
        <div>
          <h2 id="products-title">Industrial Fan Categories</h2>
          <p>Start with a category, then share the operating conditions needed for selection and quotation.</p>
        </div>
        <a class="text-link" href="/request-a-quote/">Prepare an inquiry <Icon name="arrow" size={19} /></a>
      </div>

      <div class="product-grid">
        {
          productCategories.map((category, index) => (
            <a
              class:list={["product-card", index === 0 && "product-card--primary"]}
              href={`/products/${category.slug}/`}
              aria-labelledby={`product-card-${category.slug}`}
            >
              <div class="product-card__copy">
                <h3 id={`product-card-${category.slug}`}>{category.name}</h3>
                <p>{category.summary}</p>
              </div>
              <Image
                src={category.productImage}
                alt={category.productAlt}
                widths={[360, 560, 720]}
                sizes="(max-width: 760px) 88vw, (max-width: 1100px) 44vw, 29vw"
                format="webp"
                loading="lazy"
              />
              <div class="product-card__footer">
                <span>View category</span>
                <span class="product-card__arrow">
                  <Icon name="arrow" size={21} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="buyer-workspace" id="buyers" aria-labelledby="buyers-title">
      <div class="buyer-paths">
        <div class="section-heading section-heading--dark">
          <div>
            <h2 id="buyers-title">Choose the Path That Fits Your Work</h2>
            <p>One inquiry route, shaped around the information each buyer needs to start well.</p>
          </div>
        </div>

        <div class="audience-tabs" role="tablist" aria-label="Buyer type">
          {
            audiencePaths.map((path, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${path.id}`}
                aria-controls={`panel-${path.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? "0" : "-1"}
                data-audience-tab={path.id}
              >
                {path.label}
              </button>
            ))
          }
        </div>

        <div class="audience-panels">
          {
            audiencePaths.map((path, index) => (
              <article
                role="tabpanel"
                id={`panel-${path.id}`}
                aria-labelledby={`tab-${path.id}`}
                hidden={index !== 0}
                data-audience-panel={path.id}
              >
                <p class="audience-promise">{path.promise}</p>
                <ul>
                  {path.needs.map((need) => (
                    <li>{need}</li>
                  ))}
                </ul>
                <div class="audience-panel__actions">
                  <a class="panel-link" href={`/partners/${path.slug}/`}>
                    Read the {path.shortLabel.toLowerCase()} guide <Icon name="arrow" size={19} />
                  </a>
                  <button class="panel-link panel-link--secondary" type="button" data-select-audience={path.id}>
                    Use this path in the RFQ <Icon name="arrow" size={19} />
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="rfq-rail" id="request">
        <div class="rfq-rail__heading">
          <h2>Prepare Your RFQ</h2>
          <p>The full workspace checks every required detail before delivery.</p>
        </div>
        <ul class="rfq-rail__list">
          <li><strong>Buying context</strong><span>Company, market and reply channel</span></li>
          <li><strong>Product direction</strong><span>Category, model or selection help</span></li>
          <li><strong>Delivery scope</strong><span>Quantity, destination and timing</span></li>
        </ul>

        <a class="button button--wide" href="/request-a-quote/">
          Open the RFQ workspace <Icon name="arrow" size={21} />
        </a>

        <div class="contact-preview" aria-label="Contact channels">
          <p>Other ways to contact us</p>
          <ul>
            {contactChannels.map((channel) => (
              <li>
                {channel.status === "active" ? (
                  <a class={channel.kind === "email" ? "contact-email-link" : undefined} href={channel.href}>
                    {channel.kind === "email" ? channel.address : "WhatsApp QR code"}
                  </a>
                ) : (
                  <>{channel.name}<span>Details pending</span></>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    import "../scripts/product-gallery";

    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-audience-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-audience-panel]"));

    function activateAudience(id: string, moveFocus = false) {
      tabs.forEach((tab) => {
        const active = tab.dataset.audienceTab === id;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.audiencePanel !== id;
      });

    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateAudience(tab.dataset.audienceTab ?? "distributor"));
      tab.addEventListener("keydown", (event) => {
        const vertical = window.matchMedia("(max-width: 720px)").matches;
        const previous = vertical ? "ArrowUp" : "ArrowLeft";
        const next = vertical ? "ArrowDown" : "ArrowRight";
        if (![previous, next, "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const step = event.key === next ? 1 : -1;
        const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (index + step + tabs.length) % tabs.length;
        activateAudience(tabs[nextIndex].dataset.audienceTab ?? "distributor", true);
      });
    });

    const tabLayout = window.matchMedia("(max-width: 720px)");
    const updateTabOrientation = () => document.querySelector(".audience-tabs")?.setAttribute("aria-orientation", tabLayout.matches ? "vertical" : "horizontal");
    updateTabOrientation();
    tabLayout.addEventListener("change", updateTabOrientation);

    document.querySelectorAll<HTMLButtonElement>("[data-select-audience]").forEach((button) => {
      button.addEventListener("click", () => {
        const audience = button.dataset.selectAudience ?? "distributor";
        window.location.assign(`/request-a-quote/?audience=${encodeURIComponent(audience)}`);
      });
    });
  </script>
</BaseLayout>
