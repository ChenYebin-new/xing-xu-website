---
import { Image } from "astro:assets";

import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import storefrontPlaceholder from "../assets/evidence-placeholders/storefront-placeholder.png";
import warehousePlaceholder from "../assets/evidence-placeholders/warehouse-placeholder.png";
import productPlaceholder from "../assets/evidence-placeholders/product-placeholder.png";
import nameplatePlaceholder from "../assets/evidence-placeholders/nameplate-placeholder.png";
import {
  audiencePaths,
  capabilities,
  contactChannels,
  evidenceSlots,
  productCategories,
} from "../data/site";

const pageTitle = "XINGXU FAN | Industrial Fan Supply & Sourcing";
const pageDescription =
  "Quanzhou-based industrial fan supply, selection advice, cross-brand sourcing, export packaging and logistics coordination for Southeast Asian buyers.";

const evidenceImages = {
  storefront: {
    src: storefrontPlaceholder,
    alt: "Generated generic storefront photo placeholder, not the Xingxu business location",
  },
  warehouse: {
    src: warehousePlaceholder,
    alt: "Generated generic warehouse photo placeholder, not the Xingxu warehouse",
  },
  product: {
    src: productPlaceholder,
    alt: "Generated generic industrial fan photo placeholder, not a stocked Xingxu product",
  },
  nameplate: {
    src: nameplatePlaceholder,
    alt: "Generated blank equipment nameplate placeholder, not a real product nameplate",
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="top">
    <section class="hero" id="about" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="company-name">Quanzhou Xingxu Fan & Ventilation Supply</p>
        <h1 id="hero-title">Nearly 30 Years of Hands-On Fan Supply</h1>
        <p class="hero__lede">
          Industrial fan supply and sourcing support for distributors, engineering contractors and equipment
          manufacturers in Malaysia and the Philippines.
        </p>
        <div class="hero__actions">
          <a class="button" href="#request">Request a Quote <Icon name="arrow" size={21} /></a>
          <a class="text-link" href="/products/">Explore Products <Icon name="arrow" size={19} /></a>
        </div>
      </div>

      <figure class="hero-product">
        <div class="hero-product__frame">
          <Image
            src={productCategories[0].conceptImage}
            alt={productCategories[0].conceptAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 720px) 90vw, (max-width: 1180px) 52vw, 35vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <span class="inspection-line" aria-hidden="true"></span>
          <span class="concept-stamp">Concept visual</span>
        </div>
        <figcaption>Replace with an approved product photo before launch.</figcaption>
      </figure>

      <aside class="evidence" id="evidence" aria-labelledby="evidence-title">
        <div class="evidence__heading">
          <span aria-hidden="true"></span>
          <h2 id="evidence-title">Real Business Evidence</h2>
        </div>
        <div class="evidence__grid">
          {
            evidenceSlots.map((slot) => (
              <article class="evidence-slot">
                <div class="evidence-slot__visual">
                  <Image
                    src={evidenceImages[slot.id].src}
                    alt={evidenceImages[slot.id].alt}
                    widths={[320, 480]}
                    sizes="(max-width: 720px) 44vw, (max-width: 1180px) 22vw, 15vw"
                    format="webp"
                    loading="lazy"
                  />
                  <span class="evidence-slot__mark">
                    <Icon name={slot.id} size={32} />
                    <strong>Photo placeholder</strong>
                    <small>Source required</small>
                  </span>
                </div>
                <h3>{slot.label}</h3>
                <p>{slot.replacementNote}</p>
              </article>
            ))
          }
        </div>
        <p class="evidence__note">Only approved, traceable business photos will replace these evidence bays.</p>
      </aside>
    </section>

    <section class="capabilities" id="selection" aria-label="Confirmed support capabilities">
      {
        capabilities.map((capability) => (
          <article>
            <span aria-hidden="true"></span>
            <div>
              <h2>{capability.title}</h2>
              <p>{capability.detail}</p>
            </div>
          </article>
        ))
      }
    </section>

    <section class="products" id="products" aria-labelledby="products-title">
      <div class="section-heading">
        <div>
          <h2 id="products-title">Industrial Fan Categories</h2>
          <p>Start with a category, then share the operating conditions needed for selection and quotation.</p>
        </div>
        <a class="text-link" href="#request">Prepare an inquiry <Icon name="arrow" size={19} /></a>
      </div>

      <div class="product-grid">
        {
          productCategories.map((category, index) => (
            <article class:list={["product-card", index === 0 && "product-card--primary"]}>
              <div class="product-card__copy">
                <h3>{category.name}</h3>
                <p>{category.summary}</p>
              </div>
              <Image
                src={category.conceptImage}
                alt={category.conceptAlt}
                widths={[360, 560, 720]}
                sizes="(max-width: 760px) 88vw, (max-width: 1100px) 44vw, 29vw"
                format="webp"
                loading="lazy"
              />
              <div class="product-card__footer">
                <span>Concept image — no published SKU</span>
                <a href={`/products/${category.slug}/`} aria-label={`View ${category.name}`}>
                  <Icon name="arrow" size={21} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="buyer-workspace" id="buyers" aria-labelledby="buyers-title">
      <div class="buyer-paths">
        <div class="section-heading section-heading--dark">
          <div>
            <h2 id="buyers-title">Choose the Path That Fits Your Work</h2>
            <p>One inquiry route, shaped around the information each buyer needs to start well.</p>
          </div>
        </div>

        <div class="audience-tabs" role="tablist" aria-label="Buyer type">
          {
            audiencePaths.map((path, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${path.id}`}
                aria-controls={`panel-${path.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? "0" : "-1"}
                data-audience-tab={path.id}
              >
                {path.label}
              </button>
            ))
          }
        </div>

        <div class="audience-panels">
          {
            audiencePaths.map((path, index) => (
              <article
                role="tabpanel"
                id={`panel-${path.id}`}
                aria-labelledby={`tab-${path.id}`}
                hidden={index !== 0}
                data-audience-panel={path.id}
              >
                <p class="audience-promise">{path.promise}</p>
                <ul>
                  {path.needs.map((need) => (
                    <li>{need}</li>
                  ))}
                </ul>
                <div class="audience-panel__actions">
                  <a class="panel-link" href={`/partners/${path.slug}/`}>
                    Read the {path.shortLabel.toLowerCase()} guide <Icon name="arrow" size={19} />
                  </a>
                  <button class="panel-link panel-link--secondary" type="button" data-select-audience={path.id}>
                    Use this path in the RFQ <Icon name="arrow" size={19} />
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="rfq-rail" id="request">
        <div class="rfq-rail__heading">
          <h2>Start an RFQ</h2>
          <p>Interface preview — this phase sends and stores nothing.</p>
        </div>

        <form id="rfq-preview" novalidate>
          <div class="field-row">
            <label for="customer-type">Customer type</label>
            <select id="customer-type" name="customerType" required>
              {
                audiencePaths.map((path) => (
                  <option value={path.id}>{path.shortLabel}</option>
                ))
              }
              <option value="other">Other</option>
            </select>
          </div>

          <div class="field-row">
            <label for="product-category">Product category</label>
            <select id="product-category" name="productCategory" required>
              <option value="">Please select</option>
              {
                productCategories.map((category) => (
                  <option value={category.slug}>{category.name}</option>
                ))
              }
              <option value="selection-help">Need selection help</option>
            </select>
          </div>

          <div class="field-pair">
            <div class="field-row">
              <label for="quantity">Quantity</label>
              <input id="quantity" name="quantity" type="number" min="1" inputmode="numeric" placeholder="Enter quantity" required />
            </div>
            <div class="field-row">
              <label for="destination">Destination city or port</label>
              <input id="destination" name="destination" type="text" autocomplete="address-level2" placeholder="City or port" required />
            </div>
          </div>

          <div class="field-row">
            <label for="parameters">Specifications or operating requirements</label>
            <textarea
              id="parameters"
              name="parameters"
              rows="4"
              placeholder="Application, airflow, pressure, voltage, dimensions or other requirements"
              required></textarea>
          </div>

          <div class="field-row">
            <label for="contact-method">Preferred contact channel</label>
            <select id="contact-method" name="contactMethod" required>
              <option value="">Please select</option>
              {contactChannels.map((channel) => <option value={channel.name.toLowerCase()}>{channel.name}</option>)}
            </select>
          </div>

          <button class="button button--wide" type="button" data-preview-action>
            Review Required Information <Icon name="arrow" size={21} />
          </button>
          <output class="form-status" for="customer-type product-category quantity destination parameters contact-method" data-form-status aria-live="polite">
          </output>
        </form>

        <div class="contact-preview" aria-label="Planned contact channels">
          <p>Other ways to contact us</p>
          <ul>
            {contactChannels.map((channel) => <li>{channel.name}<span>Details pending</span></li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-audience-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-audience-panel]"));
    const customerType = document.querySelector<HTMLSelectElement>("#customer-type");
    const form = document.querySelector<HTMLFormElement>("#rfq-preview");
    const formStatus = document.querySelector<HTMLOutputElement>("[data-form-status]");

    function activateAudience(id: string, moveFocus = false) {
      tabs.forEach((tab) => {
        const active = tab.dataset.audienceTab === id;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.audiencePanel !== id;
      });

      if (customerType) customerType.value = id;
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateAudience(tab.dataset.audienceTab ?? "distributor"));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const step = event.key === "ArrowRight" ? 1 : -1;
        const nextIndex = (index + step + tabs.length) % tabs.length;
        activateAudience(tabs[nextIndex].dataset.audienceTab ?? "distributor", true);
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-select-audience]").forEach((button) => {
      button.addEventListener("click", () => {
        activateAudience(button.dataset.selectAudience ?? "distributor");
        document.querySelector("#request")?.scrollIntoView({ behavior: "smooth", block: "start" });
        customerType?.focus({ preventScroll: true });
      });
    });

    document.querySelector<HTMLButtonElement>("[data-preview-action]")?.addEventListener("click", () => {
      if (!form || !formStatus) return;

      if (!form.checkValidity()) {
        formStatus.textContent = "Complete the required fields above. No information has been sent.";
        formStatus.dataset.state = "error";
        form.reportValidity();
        return;
      }

      formStatus.textContent =
        "Preview complete. Submission, privacy consent, bot protection and email delivery will be added in Phase 4; nothing was sent or stored.";
      formStatus.dataset.state = "success";
    });
  </script>
</BaseLayout>
