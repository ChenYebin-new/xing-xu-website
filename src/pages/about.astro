---
import { Image } from "astro:assets";
import { productDetails } from "../data/imagery";

import ActionPanel from "../components/ActionPanel.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { capabilities, publicationChecklist } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About XINGXU FAN | Industrial Fan Supply & Sourcing";
const pageDescription =
  "Learn how the Quanzhou-based XINGXU FAN preview presents industrial fan supply, selection advice and sourcing with explicit evidence boundaries.";

---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <section class="about-hero" aria-labelledby="page-title">
      <div>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} />
        <h1 id="page-title">Nearly 30 Years of Hands-On Fan Supply</h1>
      </div>
      <div class="about-hero__statement">
        <p>
          XINGXU FAN is presented as a Quanzhou-based industrial fan supplier and sourcing partner serving
          distributors, engineering contractors and equipment manufacturers.
        </p>
        <p>
          This site does not describe the business as a manufacturer and does not publish certifications, customer
          names, output figures or export counts without evidence and approval.
        </p>
      </div>
    </section>

    <section class="about-capabilities" aria-labelledby="capabilities-title">
      <header class="content-heading">
        <h2 id="capabilities-title">Three ways the supply conversation can be supported</h2>
      </header>
      <div>
        {
          capabilities.map((capability) => (
            <article>
              <h3>{capability.title}</h3>
              <p>{capability.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-evidence" aria-labelledby="evidence-title">
      <header class="content-heading content-heading--light">
        <h2 id="evidence-title">A Closer Look at Fan Construction</h2>
      </header>
      <div class="about-evidence__grid">
        {
          productDetails.map((slot) => (
            <figure>
              <div>
                <Image
                  src={slot.image}
                  alt={slot.alt}
                  widths={[360, 560]}
                  sizes="(max-width: 720px) 45vw, 23vw"
                  format="webp"
                  loading="lazy"
                />
              </div>
              <figcaption>
                <strong>{slot.label}</strong>
                <small>{slot.detail}</small>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="replacement-checklist" aria-labelledby="replacement-title">
      <div>
        <h2 id="replacement-title">Evidence and approvals still required</h2>
      </div>
      <ul>
        {publicationChecklist.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <ActionPanel
      eyebrow="Discuss a requirement"
      title="Start with the product duty and buying context"
      body="Choose a fan category, then share the application, operating requirements, quantity and destination in the RFQ workspace."
      primaryHref="/products/"
      primaryLabel="View product categories"
      secondaryHref="/contact/"
      secondaryLabel="Review contact status"
    />
  </main>
</BaseLayout>
