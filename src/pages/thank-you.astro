---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Submission Status | XINGXU FAN";
const pageDescription = "A placeholder submission-status page for the future XINGXU FAN RFQ workflow.";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex>
  <main>
    <section class="status-page" aria-labelledby="page-title">
      <div>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Submission status" }]} />
        <h1 id="page-title">No Inquiry Was Sent From This Preview</h1>
        <p>
          This page reserves the success-state route for the future RFQ workflow. The current homepage form only
          reviews required fields in your browser; it does not transmit or store them.
        </p>
      </div>
      <aside>
        <strong>When live submission is implemented</strong>
        <p>A visitor will reach this page only after the server validates the request and confirms delivery.</p>
      </aside>
      <div class="status-page__actions">
        <a class="button" href="/#request">Return to RFQ preview <Icon name="arrow" size={21} /></a>
        <a class="text-link" href="/products/">Continue browsing products</a>
      </div>
    </section>
  </main>
</BaseLayout>
