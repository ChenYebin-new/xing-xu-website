---
import { Image } from "astro:assets";

import ActionPanel from "../../components/ActionPanel.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import { productCategories, productRecords } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Industrial Fan Categories | XINGXU FAN";
const pageDescription =
  "Compare three industrial fan category starting points and prepare the operating information needed for a supply inquiry.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <section class="interior-hero interior-hero--split" aria-labelledby="page-title">
      <div>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Products" }]} />
        <h1 id="page-title">Start With the Airflow Problem, Not a Guess at the Model</h1>
      </div>
      <div class="interior-hero__aside">
        <p>
          These three categories are navigation points for an inquiry. A category name does not establish suitability;
          the operating duty, installation and electrical conditions still have to be confirmed.
        </p>
        <a class="text-link" href="/#request">Prepare an RFQ <Icon name="arrow" size={19} /></a>
      </div>
    </section>

    <section class="category-index" aria-labelledby="category-index-title">
      <header class="content-heading">
        <h2 id="category-index-title">Choose the closest airflow arrangement</h2>
        <p>Each guide tells you what to bring to the first selection discussion and where a category label stops being enough.</p>
      </header>

      <div class="category-index__grid">
        {
          productCategories.map((category, index) => (
            <article class="category-feature">
              <div class="category-feature__visual">
                <Image
                  src={category.conceptImage}
                  alt={category.conceptAlt}
                  widths={[420, 720, 960]}
                  sizes="(max-width: 760px) 90vw, (max-width: 1100px) 44vw, 28vw"
                  format="webp"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <span class="concept-stamp">Concept visual</span>
              </div>
              <div class="category-feature__copy">
                <h3>{category.name}</h3>
                <p>{category.summary}</p>
                <ul aria-label={`Key inputs for ${category.name}`}>
                  {category.selectionInputs.map((input) => <li>{input}</li>)}
                </ul>
                <a class="text-link" href={`/products/${category.slug}/`}>
                  Read the selection guide <Icon name="arrow" size={19} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="publication-boundary" aria-labelledby="published-products-title">
      <div>
        <h2 id="published-products-title">No model page is published without a verified record</h2>
      </div>
      <div>
        <p>
          {productRecords.length === 0
            ? "There are currently no public SKU or model records in this preview. That is intentional: model names, photographs and specifications will be added only after they are checked and approved."
            : `${productRecords.length} verified model records are currently available.`}
        </p>
        <p class="boundary-note">Concept images on these pages show category form only. They are not stock, model or performance evidence.</p>
      </div>
    </section>

    <ActionPanel
      eyebrow="Need selection help?"
      title="Send the duty and installation constraints"
      body="Share the application, airflow and pressure if known, electrical supply, dimensions, quantity and destination. The current preview reviews required information but does not transmit it."
      primaryHref="/#request"
      primaryLabel="Prepare an RFQ"
      secondaryHref="/contact/"
      secondaryLabel="Review contact status"
    />
  </main>
</BaseLayout>
