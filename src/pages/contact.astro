---
import ActionPanel from "../components/ActionPanel.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { contactChannels, whatsAppContact } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Contact | XINGXU FAN";
const pageDescription =
  "Contact XINGXU FAN by email or scan LeoChen's WhatsApp QR code to discuss an industrial fan supply inquiry.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <section class="contact-hero" aria-labelledby="page-title">
      <div>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
        <h1 id="page-title">Contact XINGXU FAN</h1>
      </div>
      <div class="contact-hero__notice" role="note">
        <strong>Let’s discuss your fan requirement</strong>
        <p>
          Email us or scan the WhatsApp QR code below. Include the product category, quantity and destination
          so we can understand your request.
        </p>
      </div>
    </section>

    <section class="channel-status" aria-labelledby="channels-title">
      <header class="content-heading">
        <h2 id="channels-title">Ways to Contact Us</h2>
      </header>
      <ul>
        {
          contactChannels.map((channel) => (
            <li>
              <strong>{channel.name}</strong>
              {channel.status === "active" ? (
                <a class={channel.kind === "email" ? "contact-email-link" : "text-link"} href={channel.href}>
                  {channel.kind === "email" ? channel.address : "View WhatsApp QR code"}
                </a>
              ) : (
                <span>Details pending</span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="contact-whatsapp" id="whatsapp" aria-labelledby="whatsapp-title">
      <div>
        <h2 id="whatsapp-title">WhatsApp · LeoChen</h2>
        <p>Open WhatsApp on your phone and scan this QR code to add LeoChen as a contact.</p>
        <p>If you are browsing on your phone, open the original image to view or save the QR code.</p>
        <a class="text-link" href={whatsAppContact.image.src} target="_blank" rel="noopener noreferrer">
          Open original QR image
        </a>
      </div>
      <a
        class="contact-whatsapp__image"
        href={whatsAppContact.image.src}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open LeoChen’s original WhatsApp QR image in a new tab"
      >
        <img
          src={whatsAppContact.image.src}
          width={whatsAppContact.image.width}
          height={whatsAppContact.image.height}
          alt="LeoChen’s WhatsApp contact QR code"
          decoding="async"
        />
      </a>
    </section>

    <section class="inquiry-prep" aria-labelledby="prepare-title">
      <div>
        <h2 id="prepare-title">A useful first message is specific enough to review</h2>
        <p>Bringing these inputs together reduces follow-up questions and makes the supply discussion easier to scope.</p>
      </div>
      <ol>
        <li><strong>Buying context</strong><span>Customer type, company and country or region</span></li>
        <li><strong>Product direction</strong><span>Category, known model or a request for selection help</span></li>
        <li><strong>Operating duty</strong><span>Application, airflow, pressure and environment when known</span></li>
        <li><strong>Installation</strong><span>Dimensions, electrical supply and interface constraints</span></li>
        <li><strong>Commercial scope</strong><span>Quantity, destination city or port and required timing</span></li>
      </ol>
    </section>

    <ActionPanel
      eyebrow="A more detailed request"
      title="Prefer to organize your requirements in one place?"
      body="The RFQ workspace brings your buying context, product requirements, quantity and destination together. You can also contact us directly by email or WhatsApp."
      primaryHref="/request-a-quote/"
      primaryLabel="Open RFQ workspace"
      secondaryHref="/products/"
      secondaryLabel="View product categories"
    />
  </main>
</BaseLayout>
